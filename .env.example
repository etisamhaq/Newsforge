# Copy to .env and adjust. All settings live in app/config.py.
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
# Require X-API-Key on /api/v1/* (strongly recommended in production)
API_KEY=change-me
# Only when the web UI is hosted on a different origin, e.g. ["https://newsforge.example.com"]
CORS_ORIGINS=[]

USER_AGENT=NewsforgeBot/0.1 (+https://github.com/etisamhaq/Newsforge)
DEFAULT_MIN_DELAY=1.0
MAX_RESPONSE_BYTES=5242880
MAX_RETRIES=3
RESPECT_ROBOTS=true

STORE_RAW_HTML_DEFAULT=false
SEARCH_BACKEND=auto

# Optional LLM fallback for low-confidence extractions
LLM_ENABLED=false
LLM_PROVIDER=groq            # groq | anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# LLM_MODEL=claude-opus-5     # used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
