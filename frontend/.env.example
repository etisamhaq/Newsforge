# Only needed when the UI is hosted on a different origin than the API
# (e.g. a static host). Leave empty when using the bundled nginx container.
VITE_API_BASE_URL=
# Dev server proxy target (npm run dev).
VITE_DEV_API_TARGET=http://localhost:8000
# Per-person sign-in with Supabase Auth (public values). Leave empty for API-key sign-in.
# Remember to add the Supabase URL to CSP connect-src (vercel.json / CSP_CONNECT_SRC for nginx).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
